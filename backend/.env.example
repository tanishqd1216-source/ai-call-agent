# Server
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# Prisma (Postgres — e.g. a Neon connection string). Local dev and production
# both need a real Postgres reachable at this URL (Neon's free tier supports
# per-branch dev databases if you want dev/prod separation).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Webcall console (the existing calling-agent page) — swap for the current
# ngrok URL when the ERP flow's "Launch" buttons need to reach it remotely.
WEBCALL_URL="http://localhost:8080"

# Comma-separated list of origins allowed to call this API (CORS). Empty/unset
# fails closed (no origin allowed), it does NOT fall back to allowing all.
# Dev example: "http://localhost:3000,https://overdrawn-slush-refute.ngrok-free.dev"
ALLOWED_ORIGINS=""

# Server
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# Prisma (Postgres — e.g. a Neon connection string). Local dev and production
# both need a real Postgres reachable at this URL (Neon's free tier supports
# per-branch dev databases if you want dev/prod separation).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Webcall console (the existing calling-agent page) — swap for the current
# ngrok URL when the ERP flow's "Launch" buttons need to reach it remotely.
WEBCALL_URL="http://localhost:8080"

# Comma-separated list of origins allowed to call this API (CORS). Empty/unset
# fails closed (no origin allowed), it does NOT fall back to allowing all.
# Dev example: "http://localhost:3000,https://overdrawn-slush-refute.ngrok-free.dev"
ALLOWED_ORIGINS=""

# CRM/MCP integrations (backend/src/routes/integrations.ts). 32-byte key,
# base64-encoded, used for AES-256-GCM encryption of stored integration auth
# tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATIONS_ENCRYPTION_KEY=""

# Shared secret for the internal GET /api/internal/integrations endpoint —
# called by the livekit_agent Python process (not a logged-in user), checked
# against the X-Internal-Api-Key request header. Must match the same value
# configured in livekit_agent/.env as MERIDIAN_INTERNAL_API_KEY.
INTERNAL_API_KEY=""

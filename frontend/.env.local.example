# Backend API base URL. Server-side only (read in Server Components/Actions,
# never shipped to the browser) — do NOT prefix with NEXT_PUBLIC_.
# Local dev: safe to omit, falls back to http://localhost:4000.
# Deployed (Vercel): set to the deployed backend's public URL, e.g.
# https://<your-backend>.up.railway.app
API_BASE_URL="http://localhost:4000"

# Public site URL, used for OpenGraph/Twitter metadata, the sitemap, and
# robots.txt. Local dev: safe to omit, falls back to http://localhost:3000.
# Deployed: set to the site's real public URL, e.g. https://meridian.example.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
